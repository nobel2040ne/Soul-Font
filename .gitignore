# ---- OS ----
.DS_Store
*.Rhistory
# iCloud conflict copies ("views 2.py", "retro 3.css"). This repo lives under a synced
# Desktop and the pipeline writes thousands of small files, which iCloud regularly
# duplicates. No source file here legitimately has a space before its extension.
* [0-9].*
* [0-9]
# The churn-heavy directories live outside iCloud (~/Library/Application Support/soulfont)
# and are symlinked back in under these names; a fresh clone just makes real directories.
/venvproj01
/proj01/node_modules
/proj01/FONT
/proj01/static/outputs

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Virtual environments ----
venvproj01/
venv/
.venv/
env/
ENV/

# ---- Node ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Django ----
*.log
db.sqlite3
db.sqlite3-journal
/proj01/staticfiles/
local_settings.py

# ---- Secrets / env ----
.env
*.env

# ---- Large data / model / media assets (not version-controlled) ----
proj01/FONT/
proj01/media/*
# ...but keep the bundled default font the app ships with.
!proj01/media/ttf_files/
proj01/media/ttf_files/*
!proj01/media/ttf_files/MaruBuri-Regular.ttf
proj01/uploads/
proj01/checkpoints/
# Per-upload crops the pipeline writes; proj01/style/crop.py itself is source.
proj01/style/user_*/

# Generated raster outputs
*.png
# ...but keep README/docs screenshots
!docs/*.png

# ---- Model / archive binaries ----
*.pth
*.pt
*.ckpt
*.h5
*.pkl
*.zip
*.tar
*.tar.gz

# ---- Editor ----
.idea/
.vscode/
*.swp
