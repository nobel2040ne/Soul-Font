# ---- OS ----
.DS_Store
*.Rhistory
# iCloud conflict copies ("views 2.py", "retro 3.css"). This repo lives under a synced
# Desktop and the pipeline writes thousands of small files, which iCloud regularly
# duplicates. No source file here legitimately has a space before its extension.
* [0-9].*
* [0-9]

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Node ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Django ----
*.log
db.sqlite3
db.sqlite3-journal
/soulfont/staticfiles/
local_settings.py

# ---- Secrets / env ----
.env
*.env

# ---- Large data / model / media assets (not version-controlled) ----
soulfont/media/*
# ...but keep the bundled default font the app ships with.
!soulfont/media/ttf_files/
soulfont/media/ttf_files/*
!soulfont/media/ttf_files/MaruBuri-Regular.ttf
soulfont/uploads/
soulfont/checkpoints/
# Everything the pipeline generates per upload now lives under one parent.
soulfont/workdir/

# Generated raster outputs
*.png
# ...but keep README/docs screenshots
!docs/*.png

# ---- Model / archive binaries ----
*.pth
*.pt
*.ckpt
*.h5
*.pkl
*.zip
*.tar
*.tar.gz

# ---- Editor ----
.idea/
.vscode/
*.swp
